# Application
LOG_LEVEL=INFO

# Database (async PostgreSQL)
DATABASE_URL=postgresql+asyncpg://cybersim:changeme@localhost:5432/cybersim

# LLM backend: vllm (gpu / low-vram) | ollama (cpu) | openai
LLM_BACKEND=vllm

# vLLM (the LoRA adapter is served under its own model name).
# Outside docker the port is 18001; inside the compose network the backend
# overrides this to http://vllm:8001/v1.
VLLM_BASE_URL=http://localhost:18001/v1
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct-GPTQ-Int4
VLLM_LORA_MODEL=secpol
# Extra vLLM flags; for the low-vram profile set: --cpu-offload-gb 8
VLLM_EXTRA_ARGS=
HF_TOKEN=

# Ollama (CPU fallback, OpenAI-compatible endpoint)
OLLAMA_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b-instruct

# Docker
COMPOSE_PROFILES=gpu #default value - gpu

# Rule extraction (adapter served by vLLM)
LORA_STRICT=false
LORA_MAX_NEW_TOKENS=2048
LORA_MAX_INPUT_LENGTH=8192

# Chunking (characters; ~4 chars == 1 token for English)
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Documents
ALLOWED_EXTENSIONS=.pdf,.docx,.txt
MAX_UPLOAD_SIZE_MB=50

# Validation
MIN_DOCUMENT_CHARS=100
MIN_DOCUMENT_CHUNKS=1
