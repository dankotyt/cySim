# Application
LOG_LEVEL=INFO

# Database (async PostgreSQL)
DATABASE_URL=postgresql+asyncpg://cybersim:changeme@localhost:5432/cybersim

# LLM (scenario generation)
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b-q4_K_M
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=<YOUR_API_KEY>
LLM_TEMPERATURE=0.7
LLM_NUM_CTX=16384
LLM_TIMEOUT=120

# LoRA rule extraction (Qwen2.5-7B-Instruct + PEFT adapter, 4-bit)
LORA_BASE_MODEL_PATH=llms/base/Qwen2.5-7B-Instruct
LORA_ADAPTER_PATH=llms/adapters/qwen2.5-7b-instruct-secpol-lora
LORA_MAX_NEW_TOKENS=2048
LORA_MAX_INPUT_LENGTH=8192
LORA_LOAD_IN_4BIT=true
# LORA_DEVICE_MAP=auto

# Chunking (characters; ~4 chars == 1 token for English)
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Documents
ALLOWED_EXTENSIONS=.pdf,.docx,.txt
MAX_UPLOAD_SIZE_MB=50

# Validation
MIN_DOCUMENT_CHARS=100
MIN_DOCUMENT_CHUNKS=1
