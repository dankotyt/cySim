# Application
LOG_LEVEL=INFO

# Database (async PostgreSQL)
DATABASE_URL=postgresql+asyncpg://cybersim:changeme@localhost:5432/cybersim

# Storage
STORAGE_DIR=data/uploads
CHROMA_PERSIST_DIR=data/chroma
QUARANTINE_DIR=data/quarantine

# Chroma server (used instead of PersistentClient when USE_CHROMA_SERVER=true)
USE_CHROMA_SERVER=false
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Embeddings
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
OLLAMA_BASE_URL=http://localhost:11434
SENTENCE_TRANSFORMER_MODEL=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=32

# Chunking (characters; ~4 chars == 1 token for English)
CHUNK_SIZE=2000
CHUNK_OVERLAP=200

# Documents
ALLOWED_EXTENSIONS=.pdf,.docx,.txt
MAX_UPLOAD_SIZE_MB=50
DEFAULT_TENANT_ID=default
COLLECTION_PREFIX=cybersim

# Validation
MIN_DOCUMENT_CHARS=100
MIN_DOCUMENT_CHUNKS=1
RELEVANCE_THRESHOLD=0.5
