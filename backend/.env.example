# Application
LOG_LEVEL=INFO

# Database (async PostgreSQL)
DATABASE_URL=postgresql+asyncpg://cybersim:changeme@localhost:5432/cybersim

# Storage
STORAGE_DIR=data/uploads
CHROMA_PERSIST_DIR=data/chroma
QUARANTINE_DIR=data/quarantine

# Chroma server (used instead of PersistentClient when USE_CHROMA_SERVER=true)
USE_CHROMA_SERVER=false
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Embeddings
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
OLLAMA_BASE_URL=http://localhost:11434
SENTENCE_TRANSFORMER_MODEL=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=32

# LLM (scenario generation)
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b-q4_K_M
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=<YOUR_API_KEY>
LLM_TEMPERATURE=0.7
LLM_NUM_CTX=16384
LLM_TIMEOUT=120

# LLM rule structuring
RULE_STRUCTURING_BATCH_SIZE=5
RULE_DEDUP_THRESHOLD=0.9

# Chunking (characters; ~4 chars == 1 token for English)
# Work ONLY if SEMANTIC_CHUNKING_ENABLED=False
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Semantic chunking (LangChain SemanticChunker with recursive fallback)
SEMANTIC_CHUNKING_ENABLED=true
SEMANTIC_BREAKPOINT_TYPE=percentile
SEMANTIC_BREAKPOINT_AMOUNT=95

# Documents
ALLOWED_EXTENSIONS=.pdf,.docx,.txt
MAX_UPLOAD_SIZE_MB=50
DEFAULT_TENANT_ID=default
COLLECTION_PREFIX=cybersim

# Validation
MIN_DOCUMENT_CHARS=100
MIN_DOCUMENT_CHUNKS=1
RELEVANCE_THRESHOLD=0.5

# Search
MIN_SEARCH_SCORE=0.5
