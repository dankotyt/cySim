# Application
LOG_LEVEL=INFO

# Database (async PostgreSQL)
DATABASE_URL=postgresql+asyncpg://cybersim:changeme@localhost:5432/cybersim

# Storage
STORAGE_DIR=data/uploads
QUARANTINE_DIR=data/quarantine

# LLM (scenario generation and rule structuring)
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b-q4_K_M
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=<YOUR_API_KEY>
LLM_TEMPERATURE=0.7
LLM_NUM_CTX=16384
LLM_TIMEOUT=120

# LLM rule structuring
RULE_STRUCTURING_BATCH_SIZE=5

# Chunking (characters; ~4 chars == 1 token for English)
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Documents
ALLOWED_EXTENSIONS=.pdf,.docx,.txt
MAX_UPLOAD_SIZE_MB=50
DEFAULT_TENANT_ID=default

# Validation
MIN_DOCUMENT_CHARS=100
MIN_DOCUMENT_CHUNKS=1

# Search (pg_trgm similarity threshold for document_chunks)
MIN_SEARCH_SCORE=0.5
